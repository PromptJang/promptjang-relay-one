PJ_ADMIN_USERNAME=admin
PJ_ADMIN_PASSWORD=replace-with-at-least-12-characters
PJ_POSTGRES_PASSWORD=replace-this-database-password
PJ_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
PJ_MAX_PAYLOAD_BYTES=1048576
PJ_RATE_LIMIT_PER_DESTINATION_PER_MINUTE=10000
PJ_EVENT_RETENTION_DAYS=30
PJ_WORKER_CONCURRENCY=8
PJ_DELIVERY_TIMEOUT_SECONDS=15
PJ_RETRY_DELAYS_SECONDS=60,120,240,480,960
PJ_STUCK_AFTER_SECONDS=300
PJ_RESPONSE_BODY_BYTES=10240
PJ_DB_MAX_CONNECTIONS=20
PJ_SESSION_TTL_SECONDS=86400
PJ_DESTINATION_ALLOW_PRIVATE_CIDRS=
PJ_ALLOW_INSECURE_HTTP=false
# Local development only: permits a short PJ_ADMIN_PASSWORD and re-applies
# PJ_ADMIN_USERNAME/PJ_ADMIN_PASSWORD on every startup (owner reset).
PJ_ALLOW_WEAK_PASSWORD=false
PJ_OTEL_ENABLED=false
