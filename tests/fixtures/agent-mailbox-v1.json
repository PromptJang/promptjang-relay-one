{
  "contract": "promptjang-agent-mailbox-v1",
  "states": ["UNREAD", "CLAIMED", "ACKNOWLEDGED"],
  "claim": {
    "default_limit": 10,
    "maximum_limit": 100,
    "default_lease_seconds": 300,
    "minimum_lease_seconds": 30,
    "maximum_lease_seconds": 3600
  },
  "tools": [
    {
      "name": "mail_push",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mailbox": { "type": "string", "description": "Mailbox name", "minLength": 1, "maxLength": 100 },
          "payload": { "description": "JSON value or text message; optional structured task/result uses schema: promptjang.agent-message.v1", "anyOf": [{"$ref":"#/$defs/agent_message"}, {}] },
          "idempotency_key": { "type": "string", "description": "Optional producer deduplication key" }
        },
        "$defs": {
          "agent_message": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "PromptJang Agent Message Envelope v1",
            "type": "object",
            "required": [
              "schema",
              "kind",
              "correlation_id"
            ],
            "properties": {
              "schema": {
                "const": "promptjang.agent-message.v1"
              },
              "kind": {
                "enum": [
                  "task",
                  "result"
                ]
              },
              "correlation_id": {
                "type": "string",
                "minLength": 1
              },
              "sender": {
                "type": "string",
                "minLength": 1
              },
              "reply_to": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,100}$"
              },
              "task": {
                "type": "string",
                "minLength": 1
              },
              "context": {
                "type": "object"
              },
              "constraints": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "in_reply_to": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "enum": [
                  "succeeded",
                  "failed"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "error": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "task"
                    }
                  }
                },
                "then": {
                  "required": [
                    "task"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "result"
                    }
                  }
                },
                "then": {
                  "required": [
                    "in_reply_to",
                    "status",
                    "summary"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "result"
                    },
                    "status": {
                      "const": "failed"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "error"
                  ]
                }
              }
            ],
            "additionalProperties": false
          }
        },
        "required": ["mailbox", "payload"]
      }
    },
    {
      "name": "mail_claim",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mailbox": { "type": "string", "description": "Mailbox name", "minLength": 1, "maxLength": 100 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 },
          "lease_seconds": { "type": "integer", "minimum": 30, "maximum": 3600, "default": 300 }
        },
        "required": ["mailbox"]
      }
    },
    {
      "name": "mail_ack",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mailbox": { "type": "string", "description": "Mailbox name", "minLength": 1, "maxLength": 100 },
          "id": { "type": "string", "format": "uuid" },
          "claim_token": { "type": "string" }
        },
        "required": ["mailbox", "id", "claim_token"]
      }
    },
    {
      "name": "mail_nack",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mailbox": { "type": "string", "description": "Mailbox name", "minLength": 1, "maxLength": 100 },
          "id": { "type": "string", "format": "uuid" },
          "claim_token": { "type": "string" }
        },
        "required": ["mailbox", "id", "claim_token"]
      }
    },
    {
      "name": "mail_list",
      "inputSchema": { "type": "object", "properties": {} }
    }
  ]
}
