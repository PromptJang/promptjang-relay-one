{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromptJang Agent Message Envelope v1",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "correlation_id"
  ],
  "properties": {
    "schema": {
      "const": "promptjang.agent-message.v1"
    },
    "kind": {
      "enum": [
        "task",
        "result"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "sender": {
      "type": "string",
      "minLength": 1
    },
    "reply_to": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "in_reply_to": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "error": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          }
        }
      },
      "then": {
        "required": [
          "task"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          }
        }
      },
      "then": {
        "required": [
          "in_reply_to",
          "status",
          "summary"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ],
  "additionalProperties": false
}
